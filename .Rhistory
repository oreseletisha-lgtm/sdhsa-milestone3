# ============================================================
# Task 4 — Rebuild the Random Forest model from Milestone 2 artefacts
# ============================================================
# ---- Libraries ----
library(tidyverse)
library(tidymodels)
library(themis)
library(ranger)
set.seed(381)
# ---- Paths ----
base_dir <- "C:/Users/orese/OneDrive - belgiumcampus.ac.za/Documents/sdhsa-milestone3"
r_dir    <- file.path(base_dir, "R")
art_dir  <- file.path(base_dir, "artefacts")
if (!dir.exists(art_dir)) dir.create(art_dir, recursive = TRUE)
# ---- Load the split from Milestone 2 ----
split    <- readRDS(file.path(r_dir, "split.rds"))
rec_prep <- readRDS(file.path(r_dir, "recipe_prep.rds"))
# Confirm structure
cat("Split class:", class(split), "\n")
cat("Full dataset dims:", dim(split$data), "\n")
cat("Training rows:", length(split$in_id), "\n")
# ---- Rebuild train / test from the split ----
train_data <- training(split)
test_data  <- testing(split)
cat("Train dims:", dim(train_data), "\n")
cat("Test dims:", dim(test_data), "\n")
# ============================================================
# STEP A — Re-apply Task 2 leakage removal
# ============================================================
# Task 2 removed variables used to construct `vulnerable` so that
# the model cannot reconstruct the target from its own components.
# We replicate that exact list here.
leakage_vars <- c(
# Services used for services_access_score
"drinking_water_source_code", "piped_water_code", "main_toilet_code",
"shared_toilet_code", "electricity_access_code", "toilet_location_code",
"handwashing_facility_code", "water_safe_code", "water_interruptions12months_code",
# Income used for low_income
"total_monthly_household_income_raw", "income_per_capita",
"main_income_source_code", "required_income_raw", "comparative_income_code",
# Hunger / food variables
"adult_hunger_code", "child_hunger_code",
"worried_food_would_run_out_code", "unable_to_eat_healthy_food_code",
"ate_few_foods_code", "skipped_meal_code", "ate_less_code",
"ran_out_of_food_code", "hungry_but_did_not_eat_code", "whole_day_without_eating_code",
# Derived columns
"services_access_score", "food_insecure_flag", "low_income", "overcrowding"
)
extra_drop <- names(train_data)[
str_detect(names(train_data),
regex("water|toilet|electric|income|hunger|food|grant|salary|asset|fridge|washing|geyser|freezer|services_access|food_insecure|low_income|overcrowd",
ignore_case = TRUE))
]
cols_to_drop <- unique(c(leakage_vars, extra_drop))
train_data <- train_data %>% select(-any_of(cols_to_drop))
test_data  <- test_data  %>% select(-any_of(cols_to_drop))
cat("Columns after leakage removal:", ncol(train_data), "\n")
cat("Remaining columns:\n")
print(names(train_data))
# ============================================================
# STEP B — Rebuild the Task 2 recipe (`rec`)
# ============================================================
# IMPORTANT: In Task 2 the model used a *new* recipe called `rec`,
# NOT `recipe_prep`. We rebuild `rec` exactly as Task 2 defined it.
rec <- recipe(vulnerable ~ ., data = train_data) %>%
step_zv(all_predictors()) %>%
step_impute_median(all_numeric_predictors()) %>%
step_impute_mode(all_nominal_predictors()) %>%
step_dummy(all_nominal_predictors()) %>%
step_normalize(all_numeric_predictors()) %>%
step_smote(vulnerable, over_ratio = 1)
# ============================================================
# STEP C — Refit the Random Forest
# ============================================================
rf_fit <- workflow() %>%
add_model(
rand_forest(trees = 800, mtry = 8, min_n = 8) %>%
set_engine("ranger", importance = "impurity") %>%
set_mode("classification")
) %>%
add_recipe(rec) %>%
fit(data = train_data)
cat("✅ Model trained.\n")
# ============================================================
# STEP D — Save artefacts for the Shiny app
# ============================================================
saveRDS(rf_fit,   file.path(art_dir, "final_model.rds"))
saveRDS(rec,      file.path(art_dir, "final_recipe.rds"))
saveRDS(test_data, file.path(art_dir, "test_data.rds"))
# ---- Feature metadata (names, types, ranges) for validation in the app ----
feature_meta <- tibble(
name = names(train_data %>% select(-vulnerable)),
type = map_chr(train_data %>% select(-vulnerable), ~ class(.x)[1])
) %>%
rowwise() %>%
mutate(
range = if (type %in% c("numeric", "integer", "double")) {
list(range(train_data[[name]], na.rm = TRUE))
} else {
list(NULL)
}
) %>%
ungroup()
saveRDS(feature_meta, file.path(art_dir, "feature_meta.rds"))
# ============================================================
# STEP E — Smoke test: does the model reproduce Task 2 metrics?
# ============================================================
rf_pred <- predict(rf_fit, test_data, type = "prob") %>%
bind_cols(predict(rf_fit, test_data)) %>%
bind_cols(test_data %>% select(vulnerable))
cm <- conf_mat(rf_pred, truth = vulnerable, estimate = .pred_class)
cat("\n===== Smoke-test confusion matrix =====\n")
print(cm)
metrics <- tibble(
Accuracy          = accuracy(rf_pred, truth = vulnerable, estimate = .pred_class)$.estimate,
Balanced_Accuracy = bal_accuracy(rf_pred, truth = vulnerable, estimate = .pred_class)$.estimate,
Precision         = precision(rf_pred, truth = vulnerable, estimate = .pred_class, event_level = "second")$.estimate,
Recall            = recall(rf_pred, truth = vulnerable, estimate = .pred_class, event_level = "second")$.estimate,
Specificity       = spec(rf_pred, truth = vulnerable, estimate = .pred_class, event_level = "second")$.estimate,
F1                = f_meas(rf_pred, truth = vulnerable, estimate = .pred_class, event_level = "second")$.estimate,
ROC_AUC           = roc_auc(rf_pred, truth = vulnerable, `.pred_Vulnerable`)$.estimate
) %>%
mutate(across(where(is.numeric), ~ round(., 4)))
cat("\n===== Smoke-test metrics =====\n")
print(metrics)
# ---- Save the smoke test output for the report ----
write_csv(metrics, file.path(art_dir, "smoke_test_metrics.csv"))
cat("\n✅ All artefacts saved to:", art_dir, "\n")
cat("   - final_model.rds\n")
cat("   - final_recipe.rds\n")
cat("   - test_data.rds\n")
cat("   - feature_meta.rds\n")
cat("   - smoke_test_metrics.csv\n")
runApp('app/app')
